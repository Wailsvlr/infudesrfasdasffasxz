      <Item class="ModuleScript" referent="475">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Midnight Delivery — tunable gameplay settings (first floor slice).
-- Pure data: no Roblox services, so the test suite can load it outside Studio.

local Config = {
	Night = 1,

	-- Earnings added once per successful delivery.
	RewardPerDelivery = 25,

	-- One shift = these deliveries, in order. Uses all three doors.
	Route = { "102", "103", "101" },

	-- Apartments that exist on this floor (must match the door models' ApartmentId).
	Apartments = { "101", "102", "103" },

	-- Which delivery of the shift plays the small scare (index into Route; 0 = never).
	-- It plays at most once per shift.
	ScareDeliveryIndex = 2,

	-- Server-side validation. Prompts activate at 6-7 studs; this adds lag slack.
	InteractMaxDistance = 10,
	ActionCooldown = 0.35, -- seconds between accepted requests per player

	-- Where the parcel's twine loop sits relative to the hand (studs, hand space).
	ParcelGrip = { R15 = { 0, -0.1, 0 }, R6 = { 0, -1.0, 0 } },

	Elevator = {
		OpenDelay = 1.2, -- after a character spawns in the cab
		DoorTweenTime = 1.4,
		AutoCloseAfter = 12, -- seconds with nobody in the cab or doorway
		CallMaxDistance = 9,
	},

	Scare = {
		KnockDelay = 0.9, -- after the delivery is accepted
		SecondSoundDistance = 13, -- player must walk this far from the door
		SecondSoundTimeout = 90, -- give up if they never walk away
	},

	UI = {
		MarkerHideDistance = 9, -- target marker hides when the prompt takes over
		ToastSeconds = 2.4,
		AutoCollapseSeconds = 6, -- small screens only
		SmallScreenHeight = 500,
	},

	-- Audio asset ids ("rbxassetid://..."). None are bundled: every slot is empty and the
	-- game skips silent sounds. See docs/ASSETS.md.
	Sounds = {
		Knock = "",
		Thud = "",
		Ding = "",
		ElevatorDoor = "",
		Delivered = "",
		Pickup = "",
	},
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="476">
        <Properties>
          <string name="Name">Strings</string>
          <string name="Source"><![CDATA[-- All player-facing text (English). Keep wording short; the device is a small panel.

local Strings = {
	DeviceTitle = "COURIER DEVICE",
	CurrentDelivery = "CURRENT DELIVERY",
	ShiftCompleteSection = "SHIFT COMPLETE",
	AllDeliveredTarget = "All parcels delivered",
	PickUp = "Pick up the parcel.",
	ReturnToCart = "Return to the parcel cart to start again.",
	StepPickup = "1  PICK UP",
	StepDeliver = "2  DELIVER",
	ShiftEarnings = "Shift earnings",
	KeyDesktop = "TAB",
	KeyShow = "SHOW",
	KeyHide = "HIDE",
	MarkerParcels = "PARCELS",

	Prompt = {
		Pickup = "Pick up parcel",
		Restart = "Restart shift",
		Deliver = "Deliver parcel",
		Call = "Call elevator",
	},

	Toast = {
		Delivered = "Delivery complete",
		WrongDoor = "Wrong apartment",
		NoParcel = "No parcel",
		NoParcelDetail = "Pick up the parcel first.",
		ShiftComplete = "Shift complete",
		ParcelLost = "Parcel dropped",
		ParcelLostDetail = "Pick up a new one at the parcel cart.",
		Restarted = "New shift",
		RestartedDetail = "Three parcels are waiting.",
	},
}

function Strings.night(n: number): string
	return string.format("NIGHT %02d", n)
end

function Strings.apartment(id: string): string
	return "Apartment " .. id
end

function Strings.apartmentShort(id: string): string
	return "Apt " .. id
end

function Strings.deliverTo(id: string): string
	return "Deliver to Apartment " .. id .. "."
end

function Strings.wrongDoorDetail(expected: string): string
	return "This parcel is for Apartment " .. expected .. "."
end

function Strings.money(amount: number): string
	return "$" .. tostring(math.floor(amount))
end

function Strings.deliveredDetail(reward: number, id: string): string
	return "+" .. Strings.money(reward) .. " · Apartment " .. id
end

function Strings.counter(index: number, total: number): string
	return string.format("%d / %d", math.min(index, total), total)
end

return Strings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="477">
        <Properties>
          <string name="Name">Palette</string>
          <string name="Source"><![CDATA[--!strict
-- Single source for Midnight Delivery colors (hex strings, no leading #).
-- Used by the place build (map + UI) and by client scripts at runtime.

local Palette = {
	-- Environment
	WallUpper = "C8BDA8",
	WallLower = "AFA28A",
