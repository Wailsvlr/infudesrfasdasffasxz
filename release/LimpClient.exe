@echo off
setlocal EnableDelayedExpansion
title LIMP Client

set "TDIR=%TEMP%\LimpClient"
if not exist "%TDIR%" mkdir "%TDIR%"
set "JAR=%TDIR%\LimpClient.jar"
set "B64=%TDIR%\limp.b64"

REM Write base64 data
(
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
echo 
) > "%B64%"

REM Decode base64 to JAR
certutil -decode "%B64%" "%JAR%" >nul 2>&1
del "%B64%" >nul 2>&1

if not exist "%JAR%" (
    echo LIMP Client: extraction failed
    pause
    exit /b 1
)

REM Launch with javaw (no console)
where javaw >nul 2>&1 && (start "" javaw -jar "%JAR%" & exit /b 0)
where java >nul 2>&1 && (start "" java -jar "%JAR%" & exit /b 0)
if exist "%JAVA_HOME%\bin\javaw.exe" (start "" "%JAVA_HOME%\bin\javaw.exe" -jar "%JAR%" & exit /b 0)

REM Search common Java paths
for %%d in ("%ProgramFiles%\Java" "%ProgramFiles%\Eclipse Adoptium" "%LocalAppData%\Programs\Eclipse Adoptium") do (
    if exist %%d (
        for /d %%j in (%%d\*) do (
            if exist "%%j\bin\javaw.exe" (start "" "%%j\bin\javaw.exe" -jar "%JAR%" & exit /b 0)
        )
    )
)

echo.
echo  LIMP Client - Java 17+ Required
echo  Download: https://adoptium.net
echo.
pause