  <Item class="ServerScriptService" referent="538">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="539">
      <Properties>
        <string name="Name">MidnightDelivery</string>
      </Properties>
      <Item class="ModuleScript" referent="540">
        <Properties>
          <string name="Name">DeliveryService</string>
          <string name="Source"><![CDATA[-- Server-authoritative delivery service. Owns every player's delivery state and validates
-- each request (state, parcel ownership, distance, rate limit) before applying it.
-- Roblox specifics (characters, parcels, remotes) are injected so the rules can be tested
-- outside Studio; DeliveryServer wires the real ones.

local DeliveryService = {}
DeliveryService.__index = DeliveryService

export type Deps = {
	config: any,
	logic: any,
	now: () -> number,
	rootPosition: (player: any) -> any?, -- Vector3 of a living character, else nil
	attachParcel: (player: any, apartmentId: string) -> boolean,
	removeParcel: (player: any) -> (),
	publish: (player: any, snapshot: { [string]: any }) -> (),
	feedback: (player: any, payload: { [string]: any }) -> (),
	scare: (player: any, apartmentId: string) -> (),
}

function DeliveryService.new(deps: Deps)
	local self = setmetatable({}, DeliveryService)
	self.deps = deps
	self.states = {} :: { [any]: any }
	self.lastRequest = {} :: { [any]: number }
	return self
end

function DeliveryService:getState(player)
	return self.states[player]
end

function DeliveryService:_publish(player)
	local state = self.states[player]
	if state then
		self.deps.publish(player, self.deps.logic.snapshot(state, self.deps.config))
	end
end

function DeliveryService:addPlayer(player)
	if self.states[player] then
		return
	end
	self.states[player] = self.deps.logic.newState(self.deps.config)
	self:_publish(player)
end

function DeliveryService:removePlayer(player)
	self.deps.removeParcel(player)
	self.states[player] = nil
	self.lastRequest[player] = nil
end

-- Called on death, respawn and character removal. Safe to call repeatedly.
function DeliveryService:characterReset(player)
	local state = self.states[player]
	self.deps.removeParcel(player)
	if not state then
		return
	end
	if self.deps.logic.dropParcel(state) then
		self.deps.feedback(player, { kind = "parcel_lost" })
	end
	self:_publish(player)
end

-- Shared request gate: known player, living character, in range, not spamming.
function DeliveryService:_gate(player, position): (any?, string)
	local state = self.states[player]
	if not state then
		return nil, "unknown_player"
	end
	local root = self.deps.rootPosition(player)
	if root == nil then
		return nil, "no_character"
	end
	if typeof(position) ~= "Vector3" or (root - position).Magnitude > self.deps.config.InteractMaxDistance then
		return nil, "too_far"
	end
	local now = self.deps.now()
	local last = self.lastRequest[player]
	if last and now - last < self.deps.config.ActionCooldown then
		return nil, "cooldown"
	end
	self.lastRequest[player] = now
	return state, "ok"
end

function DeliveryService:requestPickup(player, pointPosition): string
	local state, reason = self:_gate(player, pointPosition)
	if not state then
		return reason
	end
	local logic, config = self.deps.logic, self.deps.config

	if state.stage == "complete" then
		local ok, code = logic.restart(state, config)
		if ok then
			self:_publish(player)
			self.deps.feedback(player, { kind = "restarted" })
		end
		return code
	end

	local ok, code = logic.pickup(state, config)
	if not ok then
		return code
	end
	local target = logic.target(state, config)
	if not self.deps.attachParcel(player, target) then
		logic.dropParcel(state) -- no hand to hold it: undo
		self:_publish(player)
		return "attach_failed"
	end
	self:_publish(player)
	return code
end

function DeliveryService:requestDeliver(player, apartmentId, doorPosition): string
	local state, reason = self:_gate(player, doorPosition)
	if not state then
		return reason
	end
	local logic, config = self.deps.logic, self.deps.config
	local result = logic.deliver(state, config, apartmentId)

	if not result.ok then
		if result.code == "wrong_door" then
			self.deps.feedback(player, { kind = "wrong_door", door = result.door, expected = result.expected })
		elseif result.code == "no_parcel" then
			self.deps.feedback(player, { kind = "no_parcel" })
		end
		return result.code
	end

	self.deps.removeParcel(player)
	self:_publish(player)
	self.deps.feedback(player, {
		kind = "delivered",
		door = result.door,
		reward = result.reward,
		earnings = result.earnings,
		complete = result.complete,
	})
	if result.scare then
		self.deps.scare(player, result.door)
	end
	return result.code
end

return DeliveryService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="541">
        <Properties>
          <string name="Name">DeliveryServer</string>
          <string name="Source"><![CDATA[-- Wires the delivery rules (DeliveryService) to the place: prompts, characters, the
-- carried parcel and the remotes. All payouts and state changes happen here, on the server.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local shared = ReplicatedStorage:WaitForChild("MidnightDelivery")
local Config = require(shared:WaitForChild("Config"))
local Logic = require(shared:WaitForChild("DeliveryLogic"))
local DeliveryService = require(script.Parent:WaitForChild("DeliveryService"))

local remotes = shared:WaitForChild("Remotes")
local feedbackRemote = remotes:WaitForChild("DeliveryFeedback")
local scareRemote = remotes:WaitForChild("ScareEvent")
local parcelTemplate = shared:WaitForChild("Assets"):WaitForChild("Parcel")

-- Edit-mode helpers (the R15 scale reference) are not part of the game.
local sceneRoot = workspace:FindFirstChild("MidnightDelivery")
local devOnly = sceneRoot and sceneRoot:FindFirstChild("_DevOnly")
if devOnly then
	devOnly:Destroy()
end

local carried: { [Player]: Model } = {}

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return (root :: BasePart).Position
end

local function removeParcel(player: Player)
	local parcel = carried[player]
	carried[player] = nil
	if parcel then
		parcel:Destroy()
	end
end

local function attachParcel(player: Player, apartmentId: string): boolean
	removeParcel(player)
	local character = player.Character
	if not character then
		return false
	end
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if not hand or not hand:IsA("BasePart") then
		return false
	end

	local parcel = parcelTemplate:Clone()
	parcel.Name = "CarriedParcel"
	local box = parcel.PrimaryPart :: BasePart
	local label = parcel:FindFirstChild("Label")
	local address = label and label:FindFirstChild("Address")
	local text = address and address:FindFirstChild("Text")
	if text then
		text.Text = "APT " .. apartmentId
	end

	-- Put the twine loop (GripAttachment) in the hand, then weld. Parts are massless and
	-- non-colliding, so carrying never changes how the character moves.
	local g = if hand.Name == "RightHand" then Config.ParcelGrip.R15 else Config.ParcelGrip.R6
	local gripInHand = hand.CFrame * CFrame.new(g[1], g[2], g[3])
	local grip = box:FindFirstChild("GripAttachment") :: Attachment
	parcel:PivotTo(gripInHand * grip.CFrame:Inverse())

	local weld = Instance.new("Weld")
	weld.Name = "HandWeld"
	weld.Part0 = hand
	weld.Part1 = box
	weld.C0 = hand.CFrame:Inverse() * box.CFrame
	weld.Parent = box

	parcel.Parent = character
	carried[player] = parcel
	return true
end

local service = DeliveryService.new({
	config = Config,
	logic = Logic,
	now = os.clock,
	rootPosition = rootPosition,
	attachParcel = attachParcel,
	removeParcel = removeParcel,
	publish = function(player, snapshot)
		for name, value in snapshot do
			player:SetAttribute(name, value)
		end
	end,
	feedback = function(player, payload)
		feedbackRemote:FireClient(player, payload)
	end,
	scare = function(player, apartmentId)
		scareRemote:FireClient(player, apartmentId)
	end,
})

local function promptAt(part: Instance): (ProximityPrompt?, Attachment?)
	local attachment = part:FindFirstChild("PromptAttachment")
	if not attachment then
		return nil, nil
	end
	return attachment:FindFirstChildOfClass("ProximityPrompt"), attachment :: Attachment
end

for _, point in CollectionService:GetTagged("MD_PickupPoint") do
	local prompt, attachment = promptAt(point)
	if prompt and attachment then
		prompt.Triggered:Connect(function(player)
			service:requestPickup(player, attachment.WorldPosition)
		end)
	end
end

for _, door in CollectionService:GetTagged("MD_ApartmentDoor") do
	local apartmentId = door:GetAttribute("ApartmentId")
	local prompt, attachment = promptAt(door)
	if prompt and attachment and type(apartmentId) == "string" then
		prompt.Triggered:Connect(function(player)
			service:requestDeliver(player, apartmentId, attachment.WorldPosition)
		end)
	end
end

local function onCharacter(player: Player, character: Model)
	service:characterReset(player)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid then
		(humanoid :: Humanoid).Died:Connect(function()
			service:characterReset(player)
		end)
	end
end

local function onPlayer(player: Player)
	service:addPlayer(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	player.CharacterRemoving:Connect(function()
		service:characterReset(player)
	end)
	if player.Character then
		onCharacter(player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayer)
Players.PlayerRemoving:Connect(function(player)
	service:removePlayer(player)
end)
for _, player in Players:GetPlayers() do
	onPlayer(player)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="542">
        <Properties>
          <string name="Name">ElevatorServer</string>
          <string name="Source"><![CDATA[-- Elevator doors (start area only; no floor travel in this slice).
-- Opens when a character spawns in the cab or someone presses the call button,
-- closes after nobody has been in the cab/doorway for a while, and reopens if someone
-- steps into the doorway while it is closing.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local shared = ReplicatedStorage:WaitForChild("MidnightDelivery")
local Config = require(shared:WaitForChild("Config"))
local E = Config.Elevator

local elevator = CollectionService:GetTagged("MD_Elevator")[1]
local zone = CollectionService:GetTagged("MD_ElevatorZone")[1] :: BasePart?
local callPlate = CollectionService:GetTagged("MD_ElevatorCallButton")[1] :: BasePart?
if not elevator or not zone then
	warn("[MidnightDelivery] Elevator parts missing; elevator disabled.")
	return
end

type Door = { part: BasePart, closed: CFrame, open: CFrame }
local doors: { Door } = {}
for _, part in CollectionService:GetTagged("MD_ElevatorDoor") do
	if part:IsA("BasePart") then
		local offset = part:GetAttribute("OpenOffset")
		if typeof(offset) == "Vector3" then
			table.insert(doors, { part = part, closed = part.CFrame, open = part.CFrame + offset })
		end
	end
end

local indicator = elevator:FindFirstChild("FloorIndicator", true)
local ding = indicator and indicator:FindFirstChild("DingSound")
local doorSound: Instance? = nil
for _, door in doors do
	doorSound = doorSound or door.part:FindFirstChild("DoorSound")
end
local ring = callPlate and callPlate.Parent and callPlate.Parent:FindFirstChild("Ring") :: BasePart?
local ringIdle = ring and { material = ring.Material, color = ring.Color }

local function play(sound: Instance?, id: string)
	if not sound or not sound:IsA("Sound") then
		return
	end
	if id ~= "" then
		sound.SoundId = id
	end
	if sound.SoundId ~= "" then
		sound:Play()
	end
end

local status = "closed" -- closed | opening | open | closing
local lastOccupied = os.clock()

local function occupied(): boolean
	local zoneCf, half = zone.CFrame, zone.Size / 2
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local p = zoneCf:PointToObjectSpace(root.Position)
			if math.abs(p.X) <= half.X and math.abs(p.Y) <= half.Y + 3 and math.abs(p.Z) <= half.Z then
				return true
			end
		end
	end
	return false
end

local function tweenDoors(toOpen: boolean): Tween?
	local info = TweenInfo.new(E.DoorTweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local last
	for _, door in doors do
		last = TweenService:Create(door.part, info, { CFrame = if toOpen then door.open else door.closed })
		last:Play()
	end
	return last
end

local function setRing(active: boolean)
	if not ring or not ringIdle then
		return
	end
	ring.Material = if active then Enum.Material.Neon else ringIdle.material
	ring.Color = if active then Color3.fromHex("D6AD62") else ringIdle.color
end

local function open()
	if status == "open" or status == "opening" then
		return
	end
	status = "opening"
	elevator:SetAttribute("DoorsOpen", true)
	play(ding, Config.Sounds.Ding)
	play(doorSound, Config.Sounds.ElevatorDoor)
	local tween = tweenDoors(true)
	local function finished()
		if status == "opening" then
			status = "open"
			lastOccupied = os.clock()
			setRing(false)
		end
	end
	if tween then
		tween.Completed:Once(finished)
	else
		finished()
	end
end

local function close()
	if status ~= "open" then
		return
	end
	status = "closing"
	elevator:SetAttribute("DoorsOpen", false)
	play(doorSound, Config.Sounds.ElevatorDoor)
	local tween = tweenDoors(false)
	if tween then
		tween.Completed:Once(function(playbackState)
			if status == "closing" and playbackState == Enum.PlaybackState.Completed then
				status = "closed"
			end
		end)
	else
		status = "closed"
	end
end

elevator:SetAttribute("DoorsOpen", false)

-- Arrival: doors open shortly after a character appears.
local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		task.delay(E.OpenDelay, open)
	end)
	if player.Character then
		task.delay(E.OpenDelay, open)
	end
end
Players.PlayerAdded:Connect(onPlayer)
for _, player in Players:GetPlayers() do
	onPlayer(player)
end

-- Call button (validated on the server like every other interaction).
if callPlate then
	local attachment = callPlate:FindFirstChild("PromptAttachment")
	local prompt = attachment and attachment:FindFirstChildOfClass("ProximityPrompt")
	if prompt and attachment and attachment:IsA("Attachment") then
		prompt.Triggered:Connect(function(player)
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or not root:IsA("BasePart") then
				return
			end
			if (root.Position - attachment.WorldPosition).Magnitude > E.CallMaxDistance then
				return
			end
			if status == "closed" or status == "closing" then
				setRing(true)
				open()
			end
		end)
	end
end

-- Auto-close / safety reopen.
task.spawn(function()
	while true do
		task.wait(0.2)
		local isOccupied = occupied()
		if status == "open" then
			if isOccupied then
				lastOccupied = os.clock()
			elseif os.clock() - lastOccupied > E.AutoCloseAfter then
				close()
			end
		elseif status == "closing" and isOccupied then
			open()
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>