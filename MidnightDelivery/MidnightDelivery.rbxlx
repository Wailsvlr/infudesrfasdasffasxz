        <Item class="LocalScript" referent="428">
          <Properties>
            <string name="Name">ClientMain</string>
            <string name="Source"><![CDATA[-- Client entry point: mirrors the server state (Player attributes MD_*) into the HUD,
-- device, prompts and target marker, and plays local feedback for server results.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")

if not game:IsLoaded() then
	game.Loaded:Wait() -- the map must be replicated before tagged parts are looked up
end

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("MidnightDelivery")
local Config = require(shared:WaitForChild("Config"))
local Strings = require(shared:WaitForChild("Strings"))
local Palette = require(shared:WaitForChild("Palette"))
local remotes = shared:WaitForChild("Remotes")
local uiTemplates = shared:WaitForChild("UI")

local here = script.Parent
local DeviceUI = require(here:WaitForChild("DeviceUI"))
local Toast = require(here:WaitForChild("Toast"))
local PromptUI = require(here:WaitForChild("PromptUI"))
local TargetMarker = require(here:WaitForChild("TargetMarker"))
local WorldFx = require(here:WaitForChild("WorldFx"))
local ScareFx = require(here:WaitForChild("ScareFx"))

-- Roblox UI that would overlap the device (player list) or has no use here
-- (backpack: no tools; health: no damage). Chat stays on, in its default place.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

do
	local missing = {}
	for key, id in Config.Sounds do
		if id == "" then
			table.insert(missing, key)
		end
	end
	if #missing > 0 then
		table.sort(missing)
		print("[MidnightDelivery] No audio assigned yet: " .. table.concat(missing, ", ") .. " (see docs/ASSETS.md)")
	end
end

local playerGui = player:WaitForChild("PlayerGui")
local hud = playerGui:WaitForChild("MidnightHUD") :: ScreenGui
local topbar = playerGui:WaitForChild("TopbarHUD") :: ScreenGui
local earningsValue = topbar:WaitForChild("Earnings"):WaitForChild("Value") :: TextLabel
local nightLabel = topbar:WaitForChild("Title"):WaitForChild("Night") :: TextLabel

local device = DeviceUI.new(hud, Strings, Palette, Config)
local toast = Toast.new(hud:WaitForChild("Toast") :: CanvasGroup, Palette, Config)
local marker = TargetMarker.new(playerGui, uiTemplates:WaitForChild("TargetMarker"), Strings, Config)
local world = WorldFx.new(Strings, Config, shared:WaitForChild("Assets"):WaitForChild("Parcel"))
PromptUI.start(playerGui, uiTemplates:WaitForChild("PromptBillboard"))

-- Layout follows the viewport (desktop, phone, window resize).
local function applyLayout()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = device:layout(viewport)
	toast:layout(viewport, scale)
end
local viewportConnection
local function watchCamera()
	if viewportConnection then
		viewportConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyLayout)
	end
	applyLayout()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

local function readState()
	return {
		night = player:GetAttribute("MD_Night") or Config.Night,
		stage = player:GetAttribute("MD_Stage") or "pickup",
		target = player:GetAttribute("MD_Target") or Config.Route[1],
		index = player:GetAttribute("MD_Index") or 1,
		total = player:GetAttribute("MD_Total") or #Config.Route,
		hasParcel = player:GetAttribute("MD_HasParcel") == true,
		earnings = player:GetAttribute("MD_Earnings") or 0,
	}
end

local lastObjective: string? = nil
local hadParcel = false
local refreshQueued = false
local function refresh()
	refreshQueued = false
	local state = readState()
	device:render(state)
	marker:setState(state)
	world:applyPrompts(state)
	earningsValue.Text = Strings.money(state.earnings)
	nightLabel.Text = Strings.night(state.night)

	if state.hasParcel and not hadParcel then
		world:playSound("Pickup", world.pickupPoint)
	end
	hadParcel = state.hasParcel

	local objective = state.stage .. "|" .. tostring(state.target) .. "|" .. tostring(state.hasParcel)
	if lastObjective ~= nil and objective ~= lastObjective then
		device:objectiveChanged()
	end
	lastObjective = objective
end

-- The server sets several attributes in a row; coalesce them into one refresh.
player.AttributeChanged:Connect(function(name)
	if string.sub(name, 1, 3) == "MD_" and not refreshQueued then
		refreshQueued = true
		task.defer(refresh)
	end
end)
refresh()
device:objectiveChanged() -- show the first delivery on arrival

local function flashEarnings()
	earningsValue.TextColor3 = Color3.fromHex(Palette.UiAccent)
	TweenService:Create(earningsValue, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextColor3 = Color3.fromHex(Palette.UiText),
	}):Play()
end

remotes:WaitForChild("DeliveryFeedback").OnClientEvent:Connect(function(payload)
	if type(payload) ~= "table" then
		return
	end
	local T = Strings.Toast
	local kind = payload.kind
	if kind == "delivered" then
		world:dropParcel(payload.door)
		flashEarnings()
		if payload.complete then
			toast:show(T.ShiftComplete, Strings.ShiftEarnings .. " " .. Strings.money(payload.earnings), "success")
		else
			toast:show(T.Delivered, Strings.deliveredDetail(payload.reward, payload.door), "success")
		end
	elseif kind == "wrong_door" then
		toast:show(T.WrongDoor, Strings.wrongDoorDetail(payload.expected), "warn")
	elseif kind == "no_parcel" then
		toast:show(T.NoParcel, T.NoParcelDetail, "warn")
	elseif kind == "parcel_lost" then
		toast:show(T.ParcelLost, T.ParcelLostDetail, "warn")
	elseif kind == "restarted" then
		toast:show(T.Restarted, T.RestartedDetail, "info")
	end
end)

remotes:WaitForChild("ScareEvent").OnClientEvent:Connect(function(apartmentId)
	if type(apartmentId) == "string" then
		ScareFx.play(apartmentId, Config)
	end
end)

-- Tab toggles the device. ContextActionService ignores keys typed into chat/text boxes,
-- and the high priority keeps Tab ours now that the player list is disabled.
ContextActionService:BindActionAtPriority("MidnightDeliveryDevice", function(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		device:toggle()
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Tab)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="429">
          <Properties>
            <string name="Name">DeviceUI</string>
            <string name="Source"><![CDATA[-- Courier device panel: one header row (also the open/close button) and one delivery card.
-- Instances live in StarterGui.MidnightHUD; this module only updates them.

local UserInputService = game:GetService("UserInputService")

local DeviceUI = {}
DeviceUI.__index = DeviceUI

function DeviceUI.new(hud: ScreenGui, Strings, Palette, Config)
	local self = setmetatable({}, DeviceUI)
	self.Strings = Strings
	self.Config = Config
	self.scale = hud:WaitForChild("Scale") :: UIScale
	self.frame = hud:WaitForChild("Device") :: Frame
	self.header = self.frame:WaitForChild("Header") :: TextButton
	self.divider = self.frame:WaitForChild("Divider") :: Frame
	self.body = self.frame:WaitForChild("Body") :: Frame
	self.summary = self.header:WaitForChild("Summary") :: TextLabel
	self.keyLabel = self.header:WaitForChild("Key"):WaitForChild("Label") :: TextLabel
	self.accent = Color3.fromHex(Palette.UiAccent)
	self.text = Color3.fromHex(Palette.UiText)
	self.isOpen = true
	self.small = false
	self.collapseToken = 0

	self.header.Activated:Connect(function()
		self:toggle()
	end)
	UserInputService.LastInputTypeChanged:Connect(function()
		self:_updateKey()
	end)
	self:_updateKey()
	return self
end

local function touchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function DeviceUI:_updateKey()
	local S = self.Strings
	if touchOnly() then
		self.keyLabel.Text = if self.isOpen then S.KeyHide else S.KeyShow
	else
		self.keyLabel.Text = S.KeyDesktop
	end
end

function DeviceUI:setOpen(open: boolean)
	self.isOpen = open
	self.body.Visible = open
	self.divider.Visible = open
	self.summary.Visible = not open
	self.collapseToken += 1
	self:_updateKey()
end

function DeviceUI:toggle()
	self:setOpen(not self.isOpen)
end

-- New objective: show the card. On small screens it folds back to the header after a
-- few seconds so it never sits over the view for long.
function DeviceUI:objectiveChanged()
	self:setOpen(true)
	if self.small then
		self.collapseToken += 1
		local token = self.collapseToken
		task.delay(self.Config.UI.AutoCollapseSeconds, function()
			if self.collapseToken == token then
				self:setOpen(false)
			end
		end)
	end
end

-- Returns the UI scale so other HUD pieces can size themselves consistently.
function DeviceUI:layout(viewport: Vector2): number
	local scale = math.clamp(viewport.Y / 720, 0.85, 1)
	self.scale.Scale = scale
	local width = math.min(320, math.floor(viewport.X * 0.42 / scale))
	self.frame.Size = UDim2.fromOffset(width, 0)
	self.small = viewport.Y < self.Config.UI.SmallScreenHeight
	return scale
end

function DeviceUI:render(state)
	local S = self.Strings
	local body = self.body
	local meta = body:FindFirstChild("Meta") :: Frame
	local section = meta:FindFirstChild("Section") :: TextLabel
	local counter = meta:FindFirstChild("Counter") :: TextLabel
	local target = body:FindFirstChild("Target") :: TextLabel
	local instruction = body:FindFirstChild("Instruction") :: TextLabel
	local steps = body:FindFirstChild("Steps") :: Frame
	local earnings = body:FindFirstChild("Earnings") :: Frame

	if state.stage == "complete" then
		section.Text = S.ShiftCompleteSection
		counter.Text = S.counter(state.total, state.total)
		target.Text = S.AllDeliveredTarget
		instruction.Text = S.ReturnToCart
		steps.Visible = false
		earnings.Visible = true
		local value = earnings:FindFirstChild("Value") :: TextLabel
		value.Text = S.money(state.earnings)
		self.summary.Text = S.ShiftCompleteSection
		return
	end

	section.Text = S.CurrentDelivery
	counter.Text = S.counter(state.index, state.total)
	target.Text = S.apartment(state.target)
	instruction.Text = if state.hasParcel then S.deliverTo(state.target) else S.PickUp
	steps.Visible = true
	earnings.Visible = false
	self.summary.Text = S.apartmentShort(state.target)

	local pick = steps:FindFirstChild("StepPickup") :: TextLabel
	local deliver = steps:FindFirstChild("StepDeliver") :: TextLabel
	if state.hasParcel then
		pick.TextColor3, pick.TextTransparency = self.text, 0.55
		deliver.TextColor3, deliver.TextTransparency = self.accent, 0
	else
		pick.TextColor3, pick.TextTransparency = self.accent, 0
		deliver.TextColor3, deliver.TextTransparency = self.text, 0.6
	end
end

return DeviceUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="430">
          <Properties>
            <string name="Name">Toast</string>
            <string name="Source"><![CDATA[-- Short result message (delivery complete / wrong apartment / ...). One at a time;
-- a new message replaces the current one.

local TweenService = game:GetService("TweenService")

local Toast = {}
Toast.__index = Toast

local FADE_IN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local FADE_OUT = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local REST = UDim2.fromScale(0.5, 0.8)
local START = UDim2.fromScale(0.5, 0.815)

function Toast.new(group: CanvasGroup, Palette, Config)
	local self = setmetatable({}, Toast)
	self.Config = Config
	self.group = group
	local panel = group:WaitForChild("Panel")
	local content = panel:WaitForChild("Content")
	self.accent = panel:WaitForChild("Accent") :: Frame
	self.title = content:WaitForChild("Title") :: TextLabel
	self.detail = content:WaitForChild("Detail") :: TextLabel
	self.colors = {
		accent = Color3.fromHex(Palette.UiAccent),
		warn = Color3.fromHex(Palette.UiWarn),
		text = Color3.fromHex(Palette.UiText),
	}
	self.token = 0
	return self
end

-- tone: "success" (amber detail) | "warn" (terracotta bar, plain detail) | "info"
function Toast:show(title: string, detail: string, tone: string)
	self.token += 1
	local token = self.token
	local c = self.colors
	self.title.Text = title
	self.detail.Text = detail
	self.accent.BackgroundColor3 = if tone == "warn" then c.warn else c.accent
	self.detail.TextColor3 = if tone == "success" then c.accent else c.text
	self.detail.TextTransparency = if tone == "success" then 0 else 0.2

	self.group.GroupTransparency = 1
	self.group.Position = START
	self.group.Visible = true
	TweenService:Create(self.group, FADE_IN, { GroupTransparency = 0, Position = REST }):Play()

	task.delay(self.Config.UI.ToastSeconds, function()
		if self.token ~= token then
			return
		end
		local out = TweenService:Create(self.group, FADE_OUT, { GroupTransparency = 1 })
		out.Completed:Once(function()
			if self.token == token then
				self.group.Visible = false
			end
		end)
		out:Play()
	end)
end

function Toast:layout(viewport: Vector2, scale: number)
	self.group.Size = UDim2.fromOffset(math.min(302, math.floor(viewport.X * 0.8 / scale)), 0)
end

return Toast
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="431">
          <Properties>
            <string name="Name">PromptUI</string>
            <string name="Source"><![CDATA[-- Custom ProximityPrompt look (prompts use Style = Custom, so Roblox draws nothing and the
-- interaction text is never shown twice). The pill sits on the prompt's attachment.
-- Touch/click on the pill works like pressing the key.

local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local PromptUI = {}

local EMPTY_BAR = UDim2.new(0, 0, 0, 2)
local FULL_BAR = UDim2.new(1, -16, 0, 2)

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		return (string.gsub(prompt.GamepadKeyCode.Name, "^Button", ""))
	end
	local ok, s = pcall(function()
		return UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
	end)
	if not ok or s == nil or s == "" then
		s = prompt.KeyboardKeyCode.Name
	end
	return string.upper(s)
end

local function isPress(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end

function PromptUI.start(playerGui: PlayerGui, template: BillboardGui)
	ProximityPromptService.PromptShown:Connect(function(prompt: ProximityPrompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		local billboard = template:Clone()
		local button = billboard:WaitForChild("Button") :: TextButton
		local keyLabel = button:WaitForChild("Key"):WaitForChild("Label") :: TextLabel
		local objectLabel = button:WaitForChild("Object") :: TextLabel
		local actionLabel = button:WaitForChild("Action") :: TextLabel
		local progress = button:WaitForChild("Progress") :: Frame

		keyLabel.Text = keyText(prompt, inputType)
		keyLabel.TextSize = if #keyLabel.Text > 1 then 11 else 15

		local function sync()
			objectLabel.Text = prompt.ObjectText
			objectLabel.Visible = prompt.ObjectText ~= ""
			actionLabel.Text = prompt.ActionText
		end
		sync()

		billboard.Adornee = prompt.Parent
		billboard.Parent = playerGui

		local connections = {}
		local holdTween: Tween? = nil
		table.insert(connections, prompt:GetPropertyChangedSignal("ActionText"):Connect(sync))
		table.insert(connections, prompt:GetPropertyChangedSignal("ObjectText"):Connect(sync))
		table.insert(connections, prompt.PromptButtonHoldBegan:Connect(function()
			if prompt.HoldDuration <= 0 then
				return
			end
			progress.Size = EMPTY_BAR
			holdTween = TweenService:Create(progress, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = FULL_BAR })
			holdTween:Play()
		end))
		table.insert(connections, prompt.PromptButtonHoldEnded:Connect(function()
			if holdTween then
				holdTween:Cancel()
				holdTween = nil
			end
			progress.Size = EMPTY_BAR
		end))
		table.insert(connections, button.InputBegan:Connect(function(input)
			if isPress(input) then
				prompt:InputHoldBegin()
			end
		end))
		table.insert(connections, button.InputEnded:Connect(function(input)
			if isPress(input) then
				prompt:InputHoldEnd()
			end
		end))

		prompt.PromptHidden:Once(function()
			for _, connection in connections do
				connection:Disconnect()
			end
			billboard:Destroy()
		end)
	end)
end

return PromptUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="432">
          <Properties>
            <string name="Name">TargetMarker</string>
            <string name="Source"><![CDATA[-- Small amber marker over the current target (parcel cart or apartment door).
-- Hidden once the player is close enough for the interaction prompt to take over.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local TargetMarker = {}
TargetMarker.__index = TargetMarker

local function markerAttachment(part: Instance?): Attachment?
	local a = part and part:FindFirstChild("MarkerAttachment")
	return if a and a:IsA("Attachment") then a else nil
end

function TargetMarker.new(playerGui: PlayerGui, template: BillboardGui, Strings, Config)
	local self = setmetatable({}, TargetMarker)
	self.Strings = Strings
	self.Config = Config
	self.gui = template:Clone()
	self.gui.Enabled = false
	self.gui.Parent = playerGui
	self.label = self.gui:WaitForChild("Label") :: TextLabel
	self.anchor = nil :: Attachment?

	RunService.RenderStepped:Connect(function()
		self:_update()
	end)
	return self
end

function TargetMarker:_find(state): (Attachment?, string)
	if state.stage == "deliver" then
		for _, door in CollectionService:GetTagged("MD_ApartmentDoor") do
			if door:GetAttribute("ApartmentId") == state.target then
				return markerAttachment(door), state.target
			end
		end
		return nil, ""
	end
	return markerAttachment(CollectionService:GetTagged("MD_PickupPoint")[1]), self.Strings.MarkerParcels
end

function TargetMarker:setState(state)
	local anchor, text = self:_find(state)
	self.anchor = anchor
	self.gui.Adornee = anchor
	self.label.Text = text
end

function TargetMarker:_update()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local anchor = self.anchor
	if not anchor or not root or not root:IsA("BasePart") then
		self.gui.Enabled = false
		return
	end
	local distance = (root.Position - anchor.WorldPosition).Magnitude
	self.gui.Enabled = distance > self.Config.UI.MarkerHideDistance
end

return TargetMarker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="433">
          <Properties>
            <string name="Name">WorldFx</string>
            <string name="Source"><![CDATA[-- Local-only world feedback: which prompts this player can use, the parcel set down on
-- the doormat after a delivery, and small sounds. Nothing here changes game state.

local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local WorldFx = {}
WorldFx.__index = WorldFx

local function promptIn(part: Instance?): ProximityPrompt?
	local a = part and part:FindFirstChild("PromptAttachment")
	return a and a:FindFirstChildOfClass("ProximityPrompt")
end

function WorldFx.new(Strings, Config, parcelTemplate: Model)
	local self = setmetatable({}, WorldFx)
	self.Strings = Strings
	self.Config = Config
	self.parcelTemplate = parcelTemplate
	self.pickupPoint = CollectionService:GetTagged("MD_PickupPoint")[1]
	self.pickupPrompt = promptIn(self.pickupPoint)
	self.callPrompt = promptIn(CollectionService:GetTagged("MD_ElevatorCallButton")[1])
	self.elevator = CollectionService:GetTagged("MD_Elevator")[1]
	self.doors = {} :: { [string]: BasePart }
	self.doorPrompts = {} :: { [string]: ProximityPrompt }
	for _, door in CollectionService:GetTagged("MD_ApartmentDoor") do
		local id = door:GetAttribute("ApartmentId")
		if type(id) == "string" and door:IsA("BasePart") then
			self.doors[id] = door
			self.doorPrompts[id] = promptIn(door) :: ProximityPrompt
		end
	end

	if self.elevator then
		self.elevator:GetAttributeChangedSignal("DoorsOpen"):Connect(function()
			self:_applyCall()
		end)
	end
	self:_applyCall()
	return self
end

function WorldFx:_applyCall()
	if self.callPrompt and self.elevator then
		self.callPrompt.Enabled = self.elevator:GetAttribute("DoorsOpen") ~= true
	end
end

-- Only the interactions that make sense right now are shown to this player.
-- The server still validates every trigger.
function WorldFx:applyPrompts(state)
	local S = self.Strings
	if self.pickupPrompt then
		self.pickupPrompt.Enabled = state.stage ~= "deliver"
		self.pickupPrompt.ActionText = if state.stage == "complete" then S.Prompt.Restart else S.Prompt.Pickup
	end
	for _, prompt in self.doorPrompts do
		prompt.Enabled = state.stage == "deliver" and state.hasParcel
	end
end

function WorldFx:playSound(key: string, parent: Instance?)
	local id = self.Config.Sounds[key]
	if type(id) ~= "string" or id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = 0.5
	if parent then
		sound.Parent = parent
		sound:Play()
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	else
		SoundService:PlayLocalSound(sound)
		sound:Destroy()
	end
end

-- The delivered parcel is set down on the doormat, then fades away.
function WorldFx:dropParcel(apartmentId: string)
	local door = self.doors[apartmentId]
	local drop = door and door:FindFirstChild("DropAttachment")
	if not door or not drop or not drop:IsA("Attachment") then
		return
	end
	self:playSound("Delivered", door)

	local ghost = self.parcelTemplate:Clone()
	ghost.Name = "DeliveredParcel"
	local parts = {}
	for _, d in ghost:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			table.insert(parts, d)
		elseif d:IsA("TextLabel") then
			d.Text = "APT " .. apartmentId
		end
	end
	local yaw = math.rad(math.random(-12, 12))
	ghost:PivotTo(CFrame.new(drop.WorldPosition) * door.CFrame.Rotation * CFrame.Angles(0, yaw, 0))
	ghost.Parent = workspace

	task.delay(2.2, function()
		for _, d in ghost:GetDescendants() do
			if d:IsA("SurfaceGui") then
				d.Enabled = false
			end
		end
		local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		for _, p in parts do
			TweenService:Create(p, info, { Transparency = 1 }):Play()
		end
		task.delay(0.7, function()
			ghost:Destroy()
		end)
	end)
end

return WorldFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="434">
          <Properties>
            <string name="Name">ScareFx</string>
            <string name="Source"><![CDATA[-- The small scare, played only for the player who made the delivery:
--   1. a knock from behind the door (door leaf rattles),
--   2. a brief, irregular dip of the nearest ceiling light (under a second, no strobe),
--   3. once the player has walked away, one heavier thud from the same door.
-- Missing audio does not break it: the rattle and light still play.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local ScareFx = {}

-- {brightness multiplier, seconds}
local FLICKER = { { 0.35, 0.07 }, { 1, 0.12 }, { 0.55, 0.05 }, { 1, 0.4 }, { 0.25, 0.09 }, { 1, 0 } }

local function findDoor(apartmentId: string): BasePart?
	for _, door in CollectionService:GetTagged("MD_ApartmentDoor") do
		if door:GetAttribute("ApartmentId") == apartmentId and door:IsA("BasePart") then
			return door
		end
	end
	return nil
end

local function nearestLight(position: Vector3): Model?
	local best, bestDistance = nil, math.huge
	for _, model in CollectionService:GetTagged("MD_CorridorLight") do
		local housing = model:FindFirstChild("Housing")
		if housing and housing:IsA("BasePart") then
			local d = (housing.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = model, d
			end
		end
	end
	return best
end

local function playSound(door: BasePart, name: string, id: string)
	local sound = door:FindFirstChild(name)
	if not sound or not sound:IsA("Sound") then
		return
	end
	if id ~= "" then
		sound.SoundId = id
	end
	if sound.SoundId ~= "" then
		sound:Play()
	end
end

-- Moves every part of the door leaf a few hundredths of a stud toward the corridor.
local function rattle(door: BasePart, times: { number }, amplitude: number)
	local leaf = door.Parent
	if not leaf then
		return
	end
	local parts, origins = {}, {}
	for _, d in leaf:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
			origins[d] = d.CFrame
		end
	end
	local push = door.CFrame.LookVector * amplitude
	local start = os.clock()
	for _, t in times do
		local wait = t - (os.clock() - start)
		if wait > 0 then
			task.wait(wait)
		end
		for _, p in parts do
			p.CFrame = origins[p] + push
		end
		task.wait(0.05)
		for _, p in parts do
			p.CFrame = origins[p]
		end
	end
end

local function flicker(model: Model?)
	if not model then
		return
	end
	local housing = model:FindFirstChild("Housing")
	local anchor = housing and housing:FindFirstChild("LightAnchor")
	local light = anchor and anchor:FindFirstChildOfClass("PointLight")
	local diffuser = model:FindFirstChild("Diffuser")
	if not light then
		return
	end
	local base = model:GetAttribute("BaseBrightness")
	if type(base) ~= "number" then
		base = light.Brightness
	end
	local baseTransparency = if diffuser and diffuser:IsA("BasePart") then diffuser.Transparency else 0
	for _, step in FLICKER do
		light.Brightness = base * step[1]
		if diffuser and diffuser:IsA("BasePart") then
			diffuser.Transparency = baseTransparency + (1 - step[1]) * 0.6
		end
		if step[2] > 0 then
			task.wait(step[2])
		end
	end
	light.Brightness = base
	if diffuser and diffuser:IsA("BasePart") then
		diffuser.Transparency = baseTransparency
	end
end

local function rootPart(): BasePart?
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function ScareFx.play(apartmentId: string, Config)
	local door = findDoor(apartmentId)
	if not door then
		return
	end
	local scare, sounds = Config.Scare, Config.Sounds
	task.spawn(function()
		task.wait(scare.KnockDelay)
		playSound(door, "KnockSound", sounds.Knock)
		task.spawn(rattle, door, { 0, 0.2, 0.38 }, 0.03)
		task.wait(0.15)
		flicker(nearestLight(door.Position))

		local started = os.clock()
		local walkedAway = false
		while os.clock() - started < scare.SecondSoundTimeout do
			local root = rootPart()
			if not root then
				return -- died or left: the moment is gone
			end
			if (root.Position - door.Position).Magnitude > scare.SecondSoundDistance then
				walkedAway = true
				break
			end
			task.wait(0.2)
		end
		if walkedAway then
			task.wait(0.35)
			playSound(door, "ThudSound", sounds.Thud)
			rattle(door, { 0 }, 0.06)
		end
	end)
end

return ScareFx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
